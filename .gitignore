# No build output is ignored here: make builds outside the checkout, under each
# package's OUT, default ~/.cache/dictate/<package>. A dist/, build/ or .deb that
# appears in git status is a build that wrote where it must not.
# Python tooling.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
